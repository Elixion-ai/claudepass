[Unit]
Description=ClaudePass license service (services/license, CLA-15)
Documentation=https://claudepass.com/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=license
Group=license
EnvironmentFile=/etc/claudepass/license.env
WorkingDirectory=/srv/claudepass
ExecStart=/srv/claudepass/bin/license-service
Restart=always
RestartSec=2

# Hardening. The service only needs to read its own binary/working
# directory and write to its SQLite data file; everything else is locked
# down.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/claudepass/data
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
