# ClaudePass production Caddyfile — claudepass.com.
#
# Two server blocks:
#   - www.claudepass.com: permanent redirect to the apex.
#   - claudepass.com: five routes reverse-proxy to the license service
#     (services/license, running locally as the "license" systemd unit,
#     see deploy/license.service); /dl/* is the static release mirror
#     install.sh and the Homebrew formula download from; everything else
#     is the static site (site/) with a custom 404 page.
#
# No ACME `email` directive: Caddy's automatic HTTPS works without one,
# it only forgoes renewal-problem notices. See deploy/README.md for how
# this file reaches the server and gets reloaded.
#
# security_headers is a snippet, not a directive written inline on the
# main route: a `header` block placed only inside claudepass.com's
# ordinary route decorates responses that come out of THAT route's
# handler chain. handle_errors below is a separate chain Caddy invokes
# when the primary one ends in an error (an unknown path 404s, a
# proxied backend 5xx, ...) — it does not inherit headers set in the
# route it replaced, so a `header` block written once at the top of
# claudepass.com never reached 404s or any other Caddy-generated error
# response, including this site's HSTS/CSP/nosniff/referrer headers.
# Defining the block once here and `import`ing it in both places (the
# main route and handle_errors) applies the same headers to normal and
# error responses alike without duplicating — and risking drift on —
# the CSP string itself.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The retro arcade redesign (Vault Defense landing page): every
		# script is now an external file under site/js or site/game, so
		# script-src drops to 'self' with no 'unsafe-inline' — no inline
		# <script> or inline event-handler attribute may ship anywhere
		# under site/. style-src keeps 'unsafe-inline' only because a
		# couple of existing pages still rely on it; no new page needs
		# it (retro.css is the one shared, cacheable stylesheet). The
		# Press Start 2P face is self-hosted under site/fonts, so
		# font-src is 'self' with no webfont CDN. img-src adds data:
		# for inline data-URI art without opening up remote images.
		# form-action 'self' is still what lets /pricing's form POST to
		# /checkout on the same origin.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; form-action 'self'; base-uri 'self'; frame-ancestors 'none'"
		-Server
	}
}

www.claudepass.com {
	redir https://claudepass.com{uri} permanent
}

claudepass.com {
	log {
		output file /var/log/caddy/access.log
	}

	encode gzip

	import security_headers

	root * /srv/claudepass/site

	# The license service (services/license/README.md): Checkout, the
	# post-checkout token page, reissue, Stripe's webhook, and the health
	# probe. Nothing else is proxied — every other path is the static site.
	#
	# This MUST be a `handle` block, not a bare `reverse_proxy` directive:
	# Caddy's Caddyfile adapter sorts directives of different names by a
	# fixed global order, not by their position in this file, and that
	# order places the catch-all `handle {}` file_server below BEFORE a
	# same-level bare `reverse_proxy` — so a bare `reverse_proxy` here
	# would never run (every request, including /healthz and /checkout,
	# would instead hit the catch-all file_server and 404). Grouping all
	# three branches as `handle` blocks makes them one mutually-exclusive
	# set evaluated top-to-bottom in the order written, which is what the
	# comment above always assumed.
	@licenseService path /checkout /license /reissue /webhook /healthz
	handle @licenseService {
		reverse_proxy 127.0.0.1:8080
	}

	# The release mirror install.sh and the Homebrew formula pull from
	# (CLA-16) — plain static files, directory listing off.
	handle /dl/* {
		file_server {
			browse off
		}
	}

	handle {
		file_server
	}

	handle_errors {
		import security_headers
		@404 expression `{http.error.status_code} == 404`
		rewrite @404 /404.html
		file_server
	}
}
