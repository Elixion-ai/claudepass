# ClaudePass production Caddyfile — claudepass.com.
#
# Two server blocks:
#   - www.claudepass.com: permanent redirect to the apex.
#   - claudepass.com: /dl/* is the static release mirror install.sh and
#     the Homebrew formula download from; everything else is the static
#     site (site/) with custom 404/500 pages.
#
# No ACME `email` directive: Caddy's automatic HTTPS works without one,
# it only forgoes renewal-problem notices. See deploy/README.md for how
# this file reaches the server and gets reloaded.
#
# security_headers is a snippet, not a directive written inline on the
# main route: a `header` block placed only inside claudepass.com's
# ordinary route decorates responses that come out of THAT route's
# handler chain. handle_errors below is a separate chain Caddy invokes
# when the primary one ends in an error (an unknown path 404s, a
# proxied backend 5xx, ...) — it does not inherit headers set in the
# route it replaced, so a `header` block written once at the top of
# claudepass.com never reached 404s or any other Caddy-generated error
# response, including this site's HSTS/CSP/nosniff/referrer headers.
# Defining the block once here and `import`ing it in both places (the
# main route and handle_errors) applies the same headers to normal and
# error responses alike without duplicating — and risking drift on —
# the CSP string itself.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The retro arcade redesign (Vault Defense landing page): every
		# script is now an external file under site/js or site/game, so
		# script-src drops to 'self' with no 'unsafe-inline' — no inline
		# <script> or inline event-handler attribute may ship anywhere
		# under site/. style-src is 'self' only too (CLA-92): none of
		# the 9 real served pages use an inline <style> or style=
		# attribute — retro.css is the one shared, cacheable stylesheet
		# every page links — and the only pages that ever needed
		# 'unsafe-inline' were the unlinked build-time OG/icon-generator
		# templates, which now live under tools/asset-templates/ outside
		# site/ and are never published here. The Press Start 2P face is
		# self-hosted under site/fonts, so font-src is 'self' with no
		# webfont CDN. img-src adds data: for inline data-URI art without
		# opening up remote images.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; form-action 'self'; base-uri 'self'; frame-ancestors 'none'"
		-Server
	}
}

www.claudepass.com {
	redir https://claudepass.com{uri} permanent
}

claudepass.com {
	log {
		output file /var/log/caddy/access.log
	}

	encode gzip

	import security_headers

	root * /srv/claudepass/site

	# The release mirror install.sh and the Homebrew formula pull from
	# (CLA-16) — plain static files. Caddy lists no directories unless
	# `browse` is present; `browse` takes a template path, not on/off, so
	# `browse off` made every directory request fail with a 500 (CLA-104).
	handle /dl/* {
		file_server
	}

	handle {
		file_server
	}

	handle_errors {
		import security_headers
		@404 expression `{http.error.status_code} == 404`
		rewrite @404 /404.html
		# Only Caddy-generated errors ever reach this block — a malformed
		# request, a file_server error, and the like from the static site
		# served above. There is no upstream or proxied service that
		# could itself return a 5xx here.
		@5xx expression `{http.error.status_code} >= 500`
		rewrite @5xx /500.html
		file_server
	}
}
